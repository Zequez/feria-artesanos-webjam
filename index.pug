// Website de $600mil por año


// <Map

// Lista de feriantes completa
// Ediciones
// Lista de feriantes por edición

// ~Little AI helper feature

:yaml
  CNAME: feriabosque.webjam.site
  linkMaps: https://www.google.com/maps/place/Feria+Del+Bosque/@-38.0772074,-57.56763,231m/data=!3m1!1e3!4m6!3m5!1s0x9584e0a5d4884d0d:0x47ce549b83a1992a!8m2!3d-38.0771425!4d-57.5670761!16s%2Fg%2F11cjp75w09?entry=ttu&g_ep=EgoyMDI2MTExOC4xIKXMDSoASAFQAw%3D%3D

//# EmojiFavicon
mixin EmojiFavicon(emoji)
  link(
    rel="icon"
    type="image/svg+xml"
    href=`data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${emoji}</text></svg>`
  )  

head
  meta(name="theme-color" content="oklch(43.2% 0.095 166.913)")
  meta(name="viewport" content="width=device-width, initial-scale=1.0")
  meta(charset="UTF-8")
  meta(name="description" content="Sitio web de la Feria de Artesanos del Bosque Peralta Ramos - Días y Horarios - Listado de participantes - Contactos - Documentos - Formularios - Links a redes")
  meta(property="og:image" content="https://feriabosque.webjam.site/images/feria/md.webp")
  +EmojiFavicon('⭐️')
  title Feria de Artesanos · Bosque Peralta Ramos
  

body
  div[p1.5 bg-emerald-800 gap-12 flex-cc flex-col]
    div[bg-emerald-600 w-full py6 rounded-2 shadow-[0_0_1px_2px_#0003] min-h-screen relative flex flex-col gap-6]
      div[absolute pointer-events-none top-0 inset-x-0 h-100 bg-linear-to-b from-white/10]
      //# HEADER
      header[flex-cc flex-col gap-6 max-w-screen-sm mx-auto px6]
        img[w-63](src="images/feria/md.webp")
        div
          h1[font-bold font-serif text-11/12 text-center text-shadow-[0_2px_2px_#0006] tracking-3px uppercase text-white]
            span Feria de
            br
            //span Artesanal
            span Artesanos
            br
          div[font-sans text-6/12 text-center text-shadow-[0_2px_2px_#0006] tracking-1px text-white]
            | Bosque Peralta Ramos
          a[text-center block text-gray-100 tracking-1px text-shadow-[0_1px_1px_#0006]](href="https://www.argentina.gob.ar/justicia/igj/entidades-civiles/asociaciones-civiles" target="_blank")
            | &ldquo;
            span[underline underline-dashed underline-offset-4 hover:underline-solid] Asociación Civil
            | &rdquo;
        
        div[flex-cc flex-wrap gap-2]
          mixin Maravillosa
            span[px3 py1.5 text-white bg-emerald-700 rounded-1.5]
              block
          +Maravillosa 26 puestos variables
          +Maravillosa 13 puestos permanentes
          +Maravillosa Al aire libre
          +Maravillosa Buffet y agua caliente
          +Maravillosa Baño
          +Maravillosa Casita y ludoteca para niños
          +Maravillosa Música, circo, teatro — Shows en vivo
          +Maravillosa Mesas con bancos
    
    
        div[flex gap-3]
          a[h18 w18 bg-amber-300 hover:(brightness-110)  text-red-500 rounded-6 icon-fa-location-dot flex-cc text-5rem bg-linear-to-b from-white/10 to-black/10 shadow-[0_1px_0_var(--colors-amber-800),0_0_8px_#0004] hover:scale-105 transition-transform duration-200 shadow-amber-800 text-shadow-[3px_2px_0] text-shadow-red-800](href=linkMaps, target="_blank")
          div[flex px3 py3 gap-3 font-mono font-semibold text-3.5/6 text-amber-950 text-shadow-[0_2px_0_#fff6] uppercase bg-amber-200 bg-linear-to-b from-black/3 rounded-3 shadow-[0_1px_0px] shadow-amber-900 to-white/3]
            div[flex-cc h-12 w-12 text-5rem icon-fa-calendar-days text-amber-900]
            div
              div 3pm a 6pm
              div Sábados, Domingos y feriados

      main[flex flex-col gap-6]
        mixin Categoria(emoji, name)
          div
            div[text-center text-white text-4.5/12 text-shadow-[0_1px_0_#0007] uppercase tracking-1px font-bold]
              span[text-1.4em mr-1.5 inline-block translate-y-3px]= emoji
              span[text-1.1em]= name[0]
              span[font text-0.9em]= name.slice(1)
    
            div[bg-black/20  wheel-horizontal gap-1.5 py-1.5 from-black/6 overflow-x-auto whitespace-nowrap flex justify-center-safe snap-x snap-proximity flex-wrap]
              block
          
        mixin Puesto(name)
          div[h-24 bg-white rounded-2 aspect-163/100 float-left shadow-[0_1px_1px_#0006] flex-cc snap-start]
            block
        
        +Categoria('⭐️', 'Categoría')
          +Puesto Puesto Uno
          +Puesto Puesto Dos
          +Puesto Puesto Tres
          +Puesto Puesto Cuatro
          +Puesto Puesto Cinco
          +Puesto Puesto Seis
          +Puesto Puesto Siete

        +Categoria('🍅', 'Plantas')
           +Puesto Puesto Alfa
           +Puesto Puesto Omega
           +Puesto Puesto Beta

        div[italic text-center text-black/70 text-3 opacity-60 text-shadow-[0_1px_0_#fff4] font-bold] La feria mejor organizada de Mar del Plata

    
  footer[text-3/6 bg-emerald-800 w-full text-white p-6]
    mixin Cat(name)
      div
        div[text-4/12]=name
        block
    div[grid cols-2 gap-6]
      div[w-full flex flex-col gap-6]
        +Cat('Redes')
          ul[pl-4]
            li
              a[text-sky-300 underline block](href="https://www.instagram.com/feriadeartesanosdelbosque/" target="_blank") Instagram @feriadeartesanosdelbosque
            li
              a[text-sky-300 underline block](href="https://www.facebook.com/p/Feria-Artesanal-del-Bosque-Peralta-Ramos-100064438549694/" target="_blank") Facebook
              
          
        +Cat('Documentos')
          ul[pl-4]
            li
              a[text-sky-300 underline block] Código de organización
            li
              a[text-sky-300 underline block] Formulario aplicantes
      
      div[w-full flex flex-col gap-6]
        +Cat('Contactos')
          ul[pl-4]
            li Coordinadora puestos...
            li Coordinador shows...
            li Coordinadora ludoteca...
            li Coordinadora buffet...
            li
              | Sitio web - 
              a[text-sky-300 underline](href="https://ezequielschwartzman.org") Ezequiel
              | 
              a[text-sky-300 underline](href="https://wa.me/5492235235568") 2235235568
        